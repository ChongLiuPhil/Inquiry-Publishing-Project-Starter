{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChongLiuPhil/Inquiry-Publishing-Project-Starter/schema/project-stack.schema.json",
  "title": "Inquiry Publishing Project Stack v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "profile",
    "components",
    "starter"
  ],
  "properties": {
    "schema": {
      "const": "inquiry-publishing-stack/v2"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "profile": {
      "enum": [
        "research-only",
        "publishing-only",
        "research-book",
        "full-research-publication"
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governance": {
          "$ref": "#/$defs/component"
        },
        "publishing": {
          "$ref": "#/$defs/component"
        },
        "portfolio_interface": {
          "$ref": "#/$defs/component"
        }
      }
    },
    "starter": {
      "$ref": "#/$defs/starter"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nullableSha": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectNative": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "framework",
        "adopted_commit"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string"
        },
        "adopted_commit": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "framework",
        "source",
        "adoption_state"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "adoption_state": {
          "enum": [
            "active",
            "deferred",
            "not-applicable"
          ]
        },
        "template_source_commit": {
          "$ref": "#/$defs/nullableSha"
        },
        "project_adopted_commit": {
          "$ref": "#/$defs/nullableSha"
        },
        "profile": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "adoption_mode": {
          "type": "string"
        },
        "project_native": {
          "$ref": "#/$defs/projectNative"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adoption_state": {
                "const": "active"
              }
            },
            "required": [
              "adoption_state"
            ]
          },
          "then": {
            "required": [
              "template_source_commit"
            ],
            "properties": {
              "template_source_commit": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "adoption_state": {
                "enum": [
                  "deferred",
                  "not-applicable"
                ]
              }
            },
            "required": [
              "adoption_state"
            ]
          },
          "then": {
            "properties": {
              "template_source_commit": {
                "type": "null"
              },
              "project_adopted_commit": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "profile",
        "adopted_commit"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "profile": {
          "type": "string"
        },
        "adopted_commit": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "const": "TEMPLATE_SOURCE_COMMIT_AT_ADOPTION"
            }
          ]
        },
        "project_provisioning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "request_ref",
            "platform_authorization_ref"
          ],
          "properties": {
            "profile": {
              "enum": [
                "agent-provisioned-external-ci",
                "workers-builds-native"
              ]
            },
            "request_ref": {
              "type": "string",
              "const": "project-provisioning.yaml"
            },
            "platform_authorization_ref": {
              "type": "string",
              "const": "private-platform-state"
            }
          }
        }
      }
    }
  }
}
