{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChongLiuPhil/Inquiry-Publishing-Project-Starter/schema/project-stack-lock.schema.json",
  "title": "Inquiry Publishing Project Stack Lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated",
    "resolved"
  ],
  "properties": {
    "schema": {
      "const": "inquiry-publishing-stack-lock/v2"
    },
    "generated": {
      "type": "boolean"
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ahicp",
        "ppf",
        "vault_interface",
        "starter"
      ],
      "properties": {
        "ahicp": {
          "$ref": "#/$defs/nullableSha"
        },
        "ppf": {
          "$ref": "#/$defs/nullableSha"
        },
        "vault_interface": {
          "$ref": "#/$defs/nullableSha"
        },
        "starter": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "const": "TEMPLATE_SOURCE_COMMIT_AT_ADOPTION"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generated": {
            "const": true
          }
        },
        "required": [
          "generated"
        ]
      },
      "then": {
        "properties": {
          "resolved": {
            "properties": {
              "starter": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nullableSha": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
