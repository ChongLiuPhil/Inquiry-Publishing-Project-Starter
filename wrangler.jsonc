{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inquirystack",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/_events/*"
    ]
  },
  "main": "src/worker.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true
}
